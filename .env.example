# NeuroLink TEA — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores reais

# Flask
FLASK_ENV=development
SECRET_KEY=troque-por-uma-chave-secreta-forte-aqui

# Banco de Dados PostgreSQL
DATABASE_URL=postgresql://usuario:senha@localhost:5432/neurolink_tea

# Anthropic API (IA)
ANTHROPIC_API_KEY=sk-ant-xxxx

# Z-API WhatsApp
ZAPI_INSTANCE_ID=sua-instancia
ZAPI_TOKEN=seu-token
ZAPI_BASE_URL=https://api.z-api.io/instances

# Email (para notificações)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=seu@email.com
MAIL_PASSWORD=sua-senha-app

# Google Maps (GPS)
GOOGLE_MAPS_KEY=sua-chave-maps

# Pagamentos (Pagar.me ou Stripe)
PAYMENT_API_KEY=sua-chave-pagamento
